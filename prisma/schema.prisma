generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlanCategory {
  PME
  PF
  ADESAO
  ODONTO
}

enum AccommodationType {
  ENFERMARIA
  APARTAMENTO
  SEM_ACOMODACAO
}

enum CopayType {
  SEM
  PARCIAL
  TOTAL
}

enum CoverageType {
  REDE_PROPRIA
  AMPLA
  NACIONAL
}

enum QuotationStatus {
  RASCUNHO
  ENVIADA
  ACEITA
  RECUSADA
}

model User {
  id              String      @id @default(cuid())
  name            String
  email           String      @unique
  passwordHash    String?
  planSubscription String     @default("FREE")
  quoteLimit      Int         @default(10)
  quotesUsed      Int         @default(0)
  logoUrl         String?
  role            String      @default("BROKER")
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  quotations      Quotation[]
}

model Operator {
  id        String   @id @default(cuid())
  name      String
  logoPath  String?
  createdAt DateTime @default(now())

  tables    PriceTable[]
}

model PriceTable {
  id          String       @id @default(cuid())
  operatorId  String
  operator    Operator     @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  name        String
  region      String
  state       String
  city        String?
  category    PlanCategory
  createdAt   DateTime     @default(now())

  plans       Plan[]

  @@index([state, city, category])
}

model Plan {
  id              String            @id @default(cuid())
  tableId         String
  table           PriceTable        @relation(fields: [tableId], references: [id], onDelete: Cascade)
  name            String
  accommodation   AccommodationType
  copay           CopayType
  coverage        CoverageType
  ambulatorial    Boolean           @default(false)
  refundInfo      String?
  registrationFee Decimal?          @db.Decimal(10, 2)
  createdAt       DateTime          @default(now())

  prices          PriceRule[]

  @@index([tableId])
}

model PriceRule {
  id        String   @id @default(cuid())
  planId    String
  plan      Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  minAge    Int
  maxAge    Int
  price     Decimal  @db.Decimal(10, 2)

  @@index([planId, minAge, maxAge])
}

model Quotation {
  id           String          @id @default(cuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientName   String
  clientPhone  String?
  clientEmail  String?
  city         String
  state        String
  category     PlanCategory
  beneficiaries Json           // [{ age: number, quantity: number }]
  selectedPlans Json           // snapshot dos planos + preços
  totalMonthly Decimal?        @db.Decimal(10, 2)
  status       QuotationStatus @default(RASCUNHO)
  pdfUrl       String?
  publicLink   String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([userId, createdAt])
}
